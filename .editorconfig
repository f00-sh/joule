# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Trailing spaces can be meaningful in Markdown (hard line breaks)
trim_trailing_whitespace = false

[*.{yml,yaml,toml,json,jsonc}]
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.{css,scss,less,html,htm,svg,vue,svelte}]
indent_size = 2

[*.{py,pyi}]
indent_size = 4

[*.{rs}]
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash,zsh}]
indent_size = 2

[*.{c,h,cpp,hpp,cc,hh}]
indent_size = 4

[*.{java,kt,kts}]
indent_size = 4

[*.{rb,erb}]
indent_size = 2

[*.{lua}]
indent_size = 2

[*.{sql}]
indent_size = 2

[*.{xml,csproj,fsproj,vbproj,props,targets}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[*.bat]
indent_size = 2
end_of_line = crlf

[COMMIT_EDITMSG]
max_line_length = 72
