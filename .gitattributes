# Normalize text files to LF in the repository
* text=auto eol=lf

# Explicit text
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.go text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.cmake text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.env.example text eol=lf

# Shell scripts executable bit when checked out on Unix
*.sh text eol=lf
